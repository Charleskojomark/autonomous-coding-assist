# pyenv
#   For a library or package, you might want to ignore these files since the values are
#   specific to the developer's environment. But for an application, you might want to
#   check them in.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if having platform-specific dependencies or dependencies
#   having no cross-platform support, pipenv may install dependencies that don't work, or not
#   install all needed dependencies.
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock contains specific versions of dependencies
#   installed. It is recommended to be in version control.
#poetry.lock

# uv
.venv/

