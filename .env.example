# LLM Provider (Remote)
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# GitHub Personal Access Token (required for higher rate limits)
GITHUB_TOKEN=your_github_pat_here

# ChromaDB Connection (Managed Chroma Cloud, Remote HTTP server, or local fallback)
# 1. To use Chroma Cloud (managed SaaS), set CHROMA_TENANT and CHROMA_DATABASE (and populate CHROMA_API_KEY).
CHROMA_TENANT=your_chroma_tenant_here
CHROMA_DATABASE=default

# 2. To use a self-hosted remote ChromaDB server, set CHROMA_HOST.
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_SSL=false

# Fallback persistent storage (used only if above remote connection params are omitted)
CHROMA_PERSIST_DIR=./chroma_db

# Embedding Provider Settings (Remote APIs or local fallback)
# Options: openai, cohere, huggingface, local
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Reranker Settings (Remote APIs or local fallback)
# Options: cohere, huggingface, local
RERANKER_PROVIDER=cohere
RERANKER_MODEL=rerank-english-v3.0

# API Keys for Remote Providers (Uncomment and populate as needed)
OPENAI_API_KEY=
COHERE_API_KEY=
HF_API_KEY=

# API server settings
API_HOST=0.0.0.0
API_PORT=8000

# Retrieval settings
INITIAL_RETRIEVAL_K=20
RERANKED_TOP_N=5

# Optional: post GitHub comments (requires write permission on token)
GITHUB_POST_COMMENTS=false

